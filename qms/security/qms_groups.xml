<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_qms" model="ir.module.category">
        <field name="name">QMS</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">QMS / User</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">QMS / Manager</field>
        <field name="implied_ids" eval="[(4,ref('group_user'))]" />
    </record>

    <record id="group_read_only" model="res.groups">
        <field name="name">QMS / Read Only</field>
    </record>

</odoo>
