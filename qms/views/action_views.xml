<odoo>

    <!-- TREE VIEW -->
    <record id="action_view_tree" model="ir.ui.view">
        <field name="name">qms.action.tree</field>
        <field name="model">qms.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" />
                <field name="reference" />
                <field name="name" />
                <field name="responsible_id" />
                <field name="response_type" />
                <field name="complexity" />
                <field name="date_deadline" />
                <field name="stage_id" />
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="action_view_filter" model="ir.ui.view">
        <field name="name">qms.action.filter</field>
        <field name="model">qms.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="create_date" />
                <newline />
                <filter name="type" string="Type" context="{'group_by':'response_type'}" />
            </search>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="action_view_form" model="ir.ui.view">
        <field name="name">qms.action.form</field>
        <field name="model">qms.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="reference" />
                            <field name="response_type" />
                            <field name="responsible_id" />
                            <field name="complexity" />
                        </group>
                        <group>
                            <field name="create_date" />
                            <field name="opening_date" />
                            <field name="date_closed" />
                            <field name="date_deadline" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="True" />
                        </page>
                        <page string="Effectiveness Checks">
                            <field name="effectiveness_check_ids" nolabel="True" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_qms_action_kanban" model="ir.ui.view">
        <field name="name">qms.action.kanban</field>
        <field name="model">qms.action</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="stage_id" />
                <field name="color" />
                <field name="name" />
                <field name="reference" />
                <field name="response_type" />
                <field name="complexity" />
                <field name="responsible_id" />
                <field name="create_date" />
                <field name="date_deadline" />
                <field name="active" />
                <templates>
                    <t t-name="card" t-if="record.active.raw_value">
                        <t t-set="color_map" t-value="{
                            0: '#FFFFFF', 1: '#F06050', 2: '#F4A460', 3: '#F7CD1F',
                            4: '#6CC1ED', 5: '#814968', 6: '#EB7E7F', 7: '#2C8397',
                            8: '#475577', 9: '#D6145F', 10: '#30C381', 11: '#9365B8'
                        }" />
                        <t t-set="border_color" t-value="color_map[record.color.raw_value] or '#CCCCCC'" />
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click oe_kanban_color_#{record.color.raw_value}" t-attf-style="padding: 6px; min-height: 80px; border-left: 4px solid #{border_color};">
                            <div class="o_dropdown_kanban dropdown" style="position: absolute; top: 4px; right: 4px;">
                                <a class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" role="button" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v" />
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                    <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                </div>
                            </div>
                            <div class="oe_kanban_content" style="padding-right: 20px;">
                                <div class="o_kanban_record_top mb-1">
                                    <strong class="o_kanban_record_title d-block" style="font-size: 12px; line-height: 1.2;">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body mb-1">
                                    <field name="complexity" widget="priority" />
                                    <t t-if="record.response_type.raw_value == 'improvement'">
                                        <span class="badge" style="background-color: #D4EDDA; color: #155724; font-size: 10px; padding: 3px 8px;">
                                            <field name="response_type" />
                                        </span>
                                    </t>
                                    <t t-if="record.response_type.raw_value == 'immediate'">
                                        <span class="badge" style="background-color: #D1ECF1; color: #0C5460; font-size: 10px; padding: 3px 8px;">
                                            <field name="response_type" />
                                        </span>
                                    </t>
                                    <t t-if="record.response_type.raw_value == 'correction'">
                                        <span class="badge" style="background-color: #FFF3CD; color: #856404; font-size: 10px; padding: 3px 8px;">
                                            <field name="response_type" />
                                        </span>
                                    </t>
                                    <t t-if="record.response_type.raw_value == 'preventive'">
                                        <span class="badge" style="background-color: #F8D7DA; color: #721C24; font-size: 10px; padding: 3px 8px;">
                                            <field name="response_type" />
                                        </span>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center">
                                    <field name="responsible_id" widget="many2one_avatar_user" />
                                    <t t-if="record.date_deadline.raw_value">
                                        <span t-attf-class="badge {{record.date_deadline.raw_value lt (new Date()) ? 'text-bg-danger' : 'text-bg-light'}}" style="font-size: 11px; padding: 3px 6px;">
                                            <i class="fa fa-clock-o" role="img" aria-label="Deadline" title="Deadline" /> <field name="date_deadline" />
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_action_view_tree" model="ir.actions.act_window">
        <field name="name">Actions</field>
        <field name="res_model">qms.action</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="action_menu" parent="qms.menu_qms_main" action="action_action_view_tree" sequence="30" />
    <menuitem id="menu_config_action" name="Actions" parent="qms.menu_qms_configuration" sequence="5" />

</odoo>
