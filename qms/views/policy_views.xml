<odoo>

    <!-- TREE VIEW -->
    <record id="policy_view_tree" model="ir.ui.view">
        <field name="name">qms.policy.view.tree</field>
        <field name="model">qms.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="version" />
                <field name="date" />
                <field name="last_review_date" />
                <field name="approved" />
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="policy_view_form" model="ir.ui.view">
        <field name="name">qms.policy.form</field>
        <field name="model">qms.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" text="Approved" bg_color="text-bg-success" invisible="not approved"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_approved" type="object" class="oe_stat_button" invisible="approved">
                            <i class="fa fa-check-square-o" title="Not Approved" style="color: #ff8c42; font-size: 22px; margin-top: 2px;"/>
                            <div class="o_field_widget o_stat_info" style="margin-left: 7px;">
                                <span class="o_stat_text" style="color: #212529;">Not Approved</span>
                            </div>
                        </button>
                        <button name="action_toggle_approved" type="object" class="oe_stat_button" invisible="not approved">
                            <i class="fa fa-check-square-o" title="Approved" style="color: #5cb85c; font-size: 22px; margin-top: 2px;"/>
                            <div class="o_field_widget o_stat_info" style="margin-left: 7px;">
                                <span class="o_stat_text" style="color: #212529;">Approved</span>
                            </div>
                        </button>
                        <field name="approved" invisible="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Quality Policy 2025"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="version" />
                            <field name="date" />
                            <field name="last_review_date" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" />
                        </page>
                        <page string="Components">
                            <field name="policy_component_ids" />
                        </page>
                        <page string="Versions">
                            <field name="version_ids" nolabel="True" />
                        </page>
                        <page string="Reviews">
                            <field name="review_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="policy_action_view_tree" model="ir.actions.act_window">
        <field name="name">Policies</field>
        <field name="res_model">qms.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="policy_menu" parent="qms.menu_qms_main" sequence="5" action="policy_action_view_tree" />

</odoo>
