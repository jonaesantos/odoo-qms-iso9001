<odoo>

    <!-- TREE VIEW -->
    <record id="document_view_tree" model="ir.ui.view">
        <field name="name">qms.document.view.tree</field>
        <field name="model">qms.document</field>
        <field name="arch" type="xml">
            <list name="document">
                <field name="identification" />
                <field name="name" />
                <field name="process_ids" />
                <field name="approved" />
                <field name="storage" />
                <field name="type" />
                <field name="format" />
                <field name="holding_time" />
                <field name="disposition" />
                <field name="link" />

            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="document_view_form" model="ir.ui.view">
        <field name="name">qms.document.view_form</field>
        <field name="model">qms.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_approved" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="approved">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Not Approved</span>
                            </div>
                        </button>
                        <button name="action_toggle_approved" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="not approved">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Approved</span>
                            </div>
                        </button>
                        <field name="approved" invisible="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="identification" />
                            <field name="responsible_id" />
                            <field name="type" />
                        </group>
                        <group>
                            <field name="storage" />
                            <field name="format" />
                            <field name="disposition" />
                            <field name="holding_time" />
                            <field name="relation" />
                        </group>
                    </group>
                    <group>
                        <field name="link" nolabel="True" />
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" />
                        </page>
                        <page string="Processes">
                            <field name="process_ids" />
                        </page>
                        <page string="Versions">
                            <field name="version_ids" nolabel="True" />
                        </page>
                        <page string="Reviews">
                            <div class="alert alert-info" role="alert" invisible="id">
                                Please save the document before adding reviews.
                            </div>
                            <field name="review_ids" readonly="not id" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="document_action_view_tree" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">qms.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <!-- FIXME -->
    <menuitem id="documents_menu" name="Documents" parent="menu_qms_root" sequence="5" />
    <menuitem id="document_menu" name="Documents" parent="qms.menu_qms_main" sequence="60" />
</odoo>
